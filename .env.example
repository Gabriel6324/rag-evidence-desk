# Copy to .env. Default configuration runs locally without a model key.
# .env values are strings without inline comments. Shell environment takes precedence.
RAG_EMBEDDING_MODE=hash
RAG_ANSWER_MODE=extractive

# Compatible POST /embeddings endpoint. BASE_URL must NOT end with /embeddings.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Compatible POST /chat/completions endpoint. Fill a model supported by your provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# true sends response_format={"type":"json_object"}.
# If provider does not implement that option, set false; model output must still be JSON.
LLM_JSON_MODE=true
API_TIMEOUT_SECONDS=60

# Empty URL = QdrantClient local persistence. No Docker required.
# Optional localhost server: http://127.0.0.1:6333
QDRANT_URL=
QDRANT_API_KEY=

# Optional separate data directory. Do not point two running instances at one directory.
# RAG_DATA_DIR=/absolute/path/to/rag-data
